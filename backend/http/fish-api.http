@baseUrl = http://localhost:8081
@blueTangId = 4
@clownFishId = 1
### 查询鱼类列表
GET {{baseUrl}}/api/fishes
Accept: application/json

### 根据 ID 查询鱼类
GET {{baseUrl}}/api/fishes/1
Accept: application/json

### 新增蓝吊
POST {{baseUrl}}/api/fishes
Content-Type: application/json
Accept: application/json

{
  "chineseName": "蓝吊",
  "scientificName": "Paracanthurus hepatus",
  "category": "刺尾鱼科",
  "appearance": "身体呈鲜蓝色，具有黑色纹路和黄色尾鳍",
  "habits": "主要以藻类为食，常在珊瑚礁附近活动",
  "habitat": "热带珊瑚礁海域",
  "distribution": "印度洋和太平洋热带海域",
  "protectionLevel": "暂无特殊保护级别",
  "coverImageUrl": null,
  "sourceType": "OFFICIAL",
  "sourceDescription": "项目接口测试数据"
}

### 测试新增参数校验
POST {{baseUrl}}/api/fishes
Content-Type: application/json
Accept: application/json

{
  "chineseName": "",
  "scientificName": "Invalid fish",
  "sourceType": ""
}

### 逻辑删除蓝吊
DELETE {{baseUrl}}/api/fishes/{{blueTangId}}
Accept: application/json

### 修改小丑鱼信息
PUT {{baseUrl}}/api/fishes/{{clownFishId}}
Content-Type: application/json
Accept: application/json

{
  "chineseName": "小丑鱼",
  "scientificName": "Amphiprion ocellaris",
  "category": "雀鲷科双锯鱼属",
  "appearance": "身体多为橙色，带有三条明显的白色条纹",
  "habits": "常与海葵共生，并具有明显的领地意识",
  "habitat": "热带珊瑚礁及海葵附近",
  "distribution": "印度洋和太平洋热带海域",
  "protectionLevel": "暂无特殊保护级别",
  "coverImageUrl": null,
  "sourceType": "OFFICIAL",
  "sourceDescription": "项目修改接口第二次测试"
}